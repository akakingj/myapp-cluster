{
  "id": "akakingj_cluster_info",
  "title": "AK Cluster Info",
  "description": "A small panel of up to three live values (battery power from eDrive Live, battery charge, battery, oil and coolant temperature) over the Waze map in the cluster or on the HUD, and turn signal arrows on the HUD",
  "version": "1.10.8",
  "startType": "autostart",
  "vendor": "custom",
  "loggingId": "AKCI",
  "iconGlyph": "krgauge-I",
  "signals": {
    "de.bmw.infrastructure.VehicleCondition": {
      "VehicleCondition": "s"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineTemperature": "rs",
      "statusEngineSpeed2": "rs"
    },
    "de.bmw.body.Light": {
      "StatusFunctionsIndicators": "s",
      "StatusFunctionsIndicators2": "s"
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusDayNightChangeOver": "rs",
      "statusNewCurrentUnitsStatusExt": "rs"
    },
    "de.bmw.infotainment.personalization.SessionManager": {
      "_instances": "de.bmw.infotainment.personalization.SessionManager",
      "currentUserAccountReference": "r"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusSwitchDriveDynamicSport2": "rs",
      "statusActualValueTorque2": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_optional": "directions on the HUD (the route, BMW navigation's turns, lanes)",
      "_instances": "Main_Instance",
      "guidanceState": "rs",
      "guidingProvider": "rs",
      "conclusiveDart": "rs",
      "currentLaneGuiding": "rs",
      "nextIntersection": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_optional": "directions on the HUD (the phone's turns) and the speed camera and bump test",
      "_instances": "Main_Instance",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_optional": "directions on the HUD: the phone's lanes",
      "_instances": "Main_Instance",
      "currentLaneGuiding": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_optional": "directions on the HUD: whether CarPlay is guiding",
      "_instances": "CarPlayManagerInst1",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "_optional": "directions on the HUD: whether Android Auto is guiding",
      "_instances": "AndroidAutoProjectedManagerInst1",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    },
    "de.bmw.dass.AssistedDrivingViewFunctionInput": {
      "_optional": "Driving assistant check: the cruise control (the assisted driving view's)",
      "_broadcasts": [
        "assistedDrivingViewFunctionInputIbVip"
      ]
    },
    "de.bmw.dass.pad.communication.AssistedDrivingViewLateralFunctionInput": {
      "_optional": "Driving assistant check: the steering assist (the assisted driving view's)",
      "_broadcasts": [
        "lateralFunctionInputAssistedDrivingView"
      ]
    },
    "de.bmw.dass.driverassistanceapplications.AssistedDrivingViewLateralCollisionAvoidance": {
      "_optional": "Driving assistant check: lane departure and lane change warnings (the assisted driving view's)",
      "_broadcasts": [
        "assistedDrivingViewLcaInput"
      ]
    },
    "de.bmw.dass.pad.communication.ObjectListSuAAR": {
      "_optional": "Driving assistant check: the cars around (the assisted driving view's)",
      "_broadcasts": [
        "suAARObjectList"
      ]
    },
    "de.bmw.infotainment.displaydataserver.DisplayDataServer": {
      "_optional": "Driving assistant check: the head-up display's data",
      "functionalLibraryData": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "AK Cluster Info",
      "buttons": [
        [
          "BTN_LOGS",
          "Logs"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
